---
import "@/css/reset.css";
import "@/css/global.css";
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "@/lib/consts";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | undefined;
}

const canonicalPath = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonicalURL = new URL(canonicalPath, Astro.site);
const { title, description, image } = Astro.props;
const ogImageURL = image ? new URL(image.src, Astro.site) : new URL("/metadata/opengraph-image.png", Astro.site);
const twitterImageURL = image ? new URL(image.src, Astro.site) : new URL("/metadata/twitter-image.png", Astro.site);
const ogImageWidth = image?.width ?? 1200;
const ogImageHeight = image?.height ?? 630;
---

<meta charset="utf-8" />
<style is:inline>
  @layer reset, debug, ui-sdk, base, components;
</style>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/metadata/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/metadata/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/metadata/icon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/metadata/icon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/metadata/apple-icon.png" />

<Font cssVariable="--font-alloy" preload />
<Font cssVariable="--font-maratype" preload />
<Font cssVariable="--font-geist-mono" preload />
<Font cssVariable="--font-geist-serif" preload />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta name="application-name" content={SITE_TITLE} />
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<meta name="theme-color" content="#eeeef0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0d0d" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta
  property="og:image:alt"
  content="PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION"
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@MGSimard" />
<meta name="twitter:creator" content="@MGSimard" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={twitterImageURL} />
<meta
  name="twitter:image:alt"
  content="PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION_PLACEHOLDER_DESCRIPTION"
/>
