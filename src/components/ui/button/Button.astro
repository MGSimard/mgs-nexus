---
import type { VariantProps } from "@/lib/variants";
import button from "./button";

interface Props extends VariantProps<typeof button> {
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
}

const { disabled = false, type = "button", ...variants } = Astro.props;
---

<ui-button disabled={disabled || undefined} focusable-when-disabled>
  <button
    type={type}
    aria-disabled={disabled ? "true" : undefined}
    data-disabled={disabled ? "" : undefined}
    {...button.data(variants)}>
    <slot />
  </button>
</ui-button>

<script>
  import "@ui-sdk/web/button";
</script>

<style>
  @layer components {
    button {
      display: inline-block;
      flex-shrink: 0;
      text-wrap: nowrap;
      white-space: nowrap;
      cursor: pointer;
      border-radius: 0.5rem;
      &:is(:disabled, [data-disabled], [aria-disabled="true"]) {
        cursor: not-allowed;
      }
      &:is([data-variant="display-primary"], [data-variant="display-secondary"]) {
        min-width: 10rem;
        display: grid;
        place-content: end start;
        text-align: start;
        width: 100%;
        height: 4.75rem;
        padding-inline: 1rem;
        padding-block: 0.5rem;
        font-family: var(--font-test);
        font-size: 1.4rem;
        font-weight: 700;
        text-transform: uppercase;
      }
      &[data-variant="display-primary"] {
        color: var(--gray-19);
        background: var(--gray-94);
        &:is(:hover, :focus-visible) {
          background: var(--gray-81);
        }
        &:is(:disabled, [data-disabled], [aria-disabled="true"]) {
          color: var(--gray-30);
          background: var(--gray-50);
        }
      }
      &[data-variant="display-secondary"] {
        color: var(--gray-98);
        background: var(--gray-29);
        &:is(:hover, :focus-visible) {
          background: var(--gray-27);
        }
        &:is(:disabled, [data-disabled], [aria-disabled="true"]) {
          color: cyan;
          background: red;
        }
      }
    }
  }
</style>
