---
import Layout from "../layouts/Layout.astro";

const LINKS = ["work", "stack", "intel", "logs", "schema"];
---

<Layout>
  <div id="hero">
    <main>
      <h1>MGSIMARD</h1>
      <p>FULLSTACK / DESIGN ENGINEER / LEVEL DESIGN</p>
    </main>
    <nav>
      <ul>
        {LINKS.map((link) => (
          <li>
            <a href={link}>/ {link}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Layout>

<style>
  #hero {
    height: 100dvh;
  }
  main {
  }
  h1 {
    font-size: clamp(2rem, 3vw, 4rem);
    font-family: var(--font-display);
  }
  nav {
    text-transform: uppercase;
  }
</style>
