---
import Layout from "../layouts/Layout.astro";
const LINKS = ["work", "stack", "intel", "logs", "schema"];
---

<Layout>
  <div id="hero">
    <main>
      <span>FULLSTACK / DESIGN ENGINEER / LEVEL DESIGN</span>
      <h1>MGSIMARD</h1>
      <nav>
        <ul>
          {LINKS.map((link) => (
            <li>
              <a href={link}>{link}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p>SELECT ? TO CONTINUE</p>
      <p>Something here (daterange? current company?)</p>
    </main>
  </div>
</Layout>

<style>
  #hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  h1 {
    font-family: var(--font-display);
    color: var(--accent);
    font-size: clamp(2rem, 4vw, 6rem);
  }
  nav {
    color: var(--accent);
    text-transform: uppercase;
  }
</style>
