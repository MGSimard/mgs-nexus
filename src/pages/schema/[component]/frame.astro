---
import Layout from "@/layouts/Layout.astro";
import { SITE_TITLE } from "@/lib/consts";
import { entries, type Entry } from "@/lib/schema";

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { component: entry.slug }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { name, table, Component, Demo } = entry;
const states: [string, Record<string, unknown>][] = [["rest", {}], ...Object.entries(table.states)];
const rows = table.combos();
const label = (combo: Record<string, string>) => Object.values(combo).join(" · ");
---

<Layout title={`${name} Specimens | ${SITE_TITLE}`}>
  <meta slot="head" name="robots" content="noindex" />
  <main>
    <table>
      <caption>{`${name} specimens`}</caption>
      <thead>
        <tr>
          <td></td>
          {states.map(([state]) => (
            <th scope="col">{state}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((combo) => (
          <tr>
            <th scope="row">{label(combo)}</th>
            {states.map(([, props]) => (
              <td>
                {Demo ? (
                  <Demo {...combo} {...props} />
                ) : (
                  <Component {...combo} {...props}>
                    {name}
                  </Component>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </main>
</Layout>

<style>
  @layer components {
    :global(body) {
      min-height: 0;
    }
    main {
      display: flow-root;
      padding: 1.5rem;
    }
    caption {
      padding-bottom: 1rem;
      text-align: start;
      text-transform: uppercase;
    }
    th {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 400;
      color: var(--input-bg);
      text-align: start;
      text-transform: uppercase;
      white-space: nowrap;
    }
    th,
    td {
      padding: 0.75rem 1.5rem 0.75rem 0;
      vertical-align: middle;
    }
    tbody tr + tr :is(th, td) {
      border-top: 1px dashed var(--card-bg);
    }
  }
</style>
