---
import PageLayout from "@/layouts/PageLayout.astro";
import { SITE_TITLE } from "@/lib/consts";
import { entries, type Entry } from "@/lib/schema";

export function getStaticPaths() {
  return entries.map((entry, index) => ({
    params: { component: entry.slug },
    props: {
      entry,
      previous: entries.at(index - 1)!,
      next: entries[(index + 1) % entries.length]!,
    },
  }));
}

interface Props {
  entry: Entry;
  previous: Entry;
  next: Entry;
}

const { entry, previous, next } = Astro.props;
const WIDTHS = [320, 360, 768, 1024, 1440];
const HANDLES = [
  { value: "e", label: "Resize frame width" },
  { value: "s", label: "Resize frame height" },
  { value: "se", label: "Resize frame width and height" },
];
---

<PageLayout title={`${entry.name} | Schema | ${SITE_TITLE}`}>
  <div class="schema">
    <nav class="sidebar" aria-label="Components">
      <ul>
        {entries.map(({ slug, name }) => (
          <li>
            <a href={`/schema/${slug}`} aria-current={slug === entry.slug ? "page" : undefined}>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="workspace" aria-labelledby="component-name">
      <header>
        <h1 id="component-name">{entry.name}</h1>
        <a href={`/schema/${previous.slug}`} data-cycle="previous" aria-keyshortcuts="[">
          ← {previous.name}
        </a>
        <a href={`/schema/${next.slug}`} data-cycle="next" aria-keyshortcuts="]">
          {next.name} →
        </a>
      </header>

      <ui-toolbar aria-label="View">
        <ui-toggle-group aria-label="Frame width preset" default-value="full" data-presets>
          {WIDTHS.map((width) => (
            <ui-toggle value={String(width)}>
              <button>{width}</button>
            </ui-toggle>
          ))}
          <ui-toggle value="full">
            <button>Full</button>
          </ui-toggle>
        </ui-toggle-group>
        <ui-toolbar-separator></ui-toolbar-separator>
        <ui-number-input min="120" step="1" large-step="8" data-size="width">
          <ui-toolbar-input>
            <ui-number-input-control>
              <input aria-label="Frame width" />
            </ui-number-input-control>
          </ui-toolbar-input>
        </ui-number-input>
        <span aria-hidden="true">×</span>
        <ui-number-input min="80" step="1" large-step="8" data-size="height">
          <ui-toolbar-input>
            <ui-number-input-control>
              <input aria-label="Frame height" />
            </ui-number-input-control>
          </ui-toolbar-input>
        </ui-number-input>
        <ui-toolbar-separator></ui-toolbar-separator>
        <ui-toggle data-grid-toggle>
          <button>Grid</button>
        </ui-toggle>
        <ui-toolbar-separator></ui-toolbar-separator>
        <ui-toolbar-button data-action="fit">
          <button>Fit</button>
        </ui-toolbar-button>
        <ui-toolbar-button data-action="actual">
          <button>100%</button>
        </ui-toolbar-button>
        <output data-zoom aria-label="Zoom">
          100%
        </output>
      </ui-toolbar>

      <schema-stage>
        <span class="corner" aria-hidden="true"></span>
        <schema-stage-hruler>
          <canvas></canvas>
        </schema-stage-hruler>
        <schema-stage-vruler>
          <canvas></canvas>
        </schema-stage-vruler>
        <schema-stage-surface aria-label="Specimen stage">
          <schema-stage-world>
            <schema-stage-frame>
              <iframe src={`/schema/${entry.slug}/frame`} title={`${entry.name} specimens`}></iframe>
              <div class="grid" aria-hidden="true"></div>
              {HANDLES.map(({ value, label }) => (
                <schema-stage-handle value={value}>
                  <button aria-label={label} />
                </schema-stage-handle>
              ))}
            </schema-stage-frame>
          </schema-stage-world>
        </schema-stage-surface>
      </schema-stage>
    </section>
  </div>
</PageLayout>

<script>
  import "@ui-sdk/web/toolbar";
  import "@ui-sdk/web/toggle";
  import "@ui-sdk/web/number-input";
  import "@/components/schema/stage-elements";
  import { registerShortcut } from "@ui-sdk/web";
  import type { FrameChange, FrameWidth } from "@/components/schema/stage";

  type Change<T> = CustomEvent<{ value: T; reason?: string }>;
  type StageElement = HTMLElement & {
    api: {
      fit(): void;
      actualSize(): void;
      setWidth(width: FrameWidth): void;
      setSize(width: number, height: number): void;
    };
  };
  type PresetsElement = HTMLElement & { api: { setValue(value: string[]): boolean; getValue(): string[] } };
  type NumberElement = HTMLElement & { value: number | null; format: Intl.NumberFormatOptions };

  const stage = document.querySelector<StageElement>("schema-stage")!;
  const presets = document.querySelector<PresetsElement>("[data-presets]")!;
  const width = document.querySelector<NumberElement>('[data-size="width"]')!;
  const height = document.querySelector<NumberElement>('[data-size="height"]')!;
  const zoom = document.querySelector<HTMLOutputElement>("[data-zoom]")!;
  width.format = height.format = { useGrouping: false };

  presets.addEventListener("valuechange", (event) => {
    const { value, reason } = (event as Change<string[]>).detail;
    const [preset] = value;
    if (reason === "imperative" || !preset) return;
    stage.api.setWidth(preset === "full" ? "full" : Number(preset));
  });

  stage.addEventListener("framechange", (event) => {
    const frame = (event as Change<FrameChange>).detail.value;
    width.value = Math.round(frame.width);
    height.value = Math.round(frame.height);
    const [preset] = presets.api.getValue();
    const matches = preset === "full" ? frame.full : Number(preset) === Math.round(frame.width);
    if (preset && !matches) presets.api.setValue([]);
  });

  stage.addEventListener("zoomchange", (event) => {
    zoom.value = `${Math.round((event as Change<number>).detail.value * 100)}%`;
  });

  for (const input of [width, height]) {
    input.addEventListener("valuecommit", () => {
      if (width.value === null || height.value === null) return;
      presets.api.setValue([]);
      stage.api.setSize(width.value, height.value);
    });
  }

  document.querySelector("[data-grid-toggle]")!.addEventListener("pressedchange", (event) => {
    stage.toggleAttribute("data-grid", (event as Change<boolean>).detail.value);
  });

  document.querySelector('[data-action="fit"]')!.addEventListener("click", () => stage.api.fit());
  document.querySelector('[data-action="actual"]')!.addEventListener("click", () => stage.api.actualSize());

  const cycle = (direction: string) => () =>
    document.querySelector<HTMLAnchorElement>(`[data-cycle="${direction}"]`)!.click();
  registerShortcut("[", cycle("previous"), { description: "Previous component" });
  registerShortcut("]", cycle("next"), { description: "Next component" });
</script>

<style>
  @layer components {
    .schema {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      height: calc(100dvh - var(--site-nav-height));
    }

    .sidebar {
      overflow-y: auto;
      padding: 1rem 0.5rem;
      border-right: 1px solid var(--card-bg);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      a {
        display: block;
        padding: 0.375rem 0.75rem;
        color: var(--input-bg);
        &:hover {
          color: var(--foreground);
        }
        &[aria-current="page"] {
          background: var(--card-bg);
          color: var(--foreground);
        }
      }
    }

    .workspace {
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      min-width: 0;
      min-height: 0;
    }

    header {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 0.75rem 1rem 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      h1 {
        margin-right: auto;
        font-family: var(--font-oxanium);
        font-size: 1.25rem;
        text-transform: uppercase;
      }
      a {
        color: var(--input-bg);
        &:hover {
          color: var(--foreground);
        }
      }
    }

    ui-toolbar {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.5rem 1rem;
      border-block: 1px solid var(--card-bg);
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
    ui-toggle-group {
      display: flex;
      gap: 1px;
    }
    ui-toolbar button {
      padding: 0.25rem 0.5rem;
      background: var(--secondary-button-bg);
      color: var(--secondary-button-fg);
      cursor: pointer;
      &[data-pressed] {
        background: var(--primary-button-bg);
        color: var(--primary-button-fg);
      }
      &:focus-visible {
        outline: 2px solid var(--foreground);
        outline-offset: 1px;
      }
    }
    ui-toolbar-separator {
      align-self: stretch;
      width: 1px;
      margin-inline: 0.5rem;
      background: var(--card-bg);
    }
    ui-toolbar input {
      width: 4.5rem;
      padding: 0.25rem 0.5rem;
      background: var(--input-inactive-bg);
      color: var(--input-inactive-fg);
      font-variant-numeric: tabular-nums;
      &:focus-visible {
        outline: 2px solid var(--foreground);
      }
    }
    output {
      min-width: 3.5rem;
      margin-left: 0.5rem;
      text-align: end;
      font-variant-numeric: tabular-nums;
    }

    schema-stage {
      --ruler: 1.25rem;
      display: grid;
      grid-template: var(--ruler) minmax(0, 1fr) / var(--ruler) minmax(0, 1fr);
      min-height: 0;
      font-family: var(--font-mono);
    }
    .corner,
    schema-stage-hruler,
    schema-stage-vruler {
      background: var(--background);
      color: var(--input-inactive-fg);
      --ruler-marker: var(--green);
    }
    .corner {
      border-right: 1px solid var(--card-bg);
      border-bottom: 1px solid var(--card-bg);
    }
    schema-stage-hruler {
      border-bottom: 1px solid var(--card-bg);
    }
    schema-stage-vruler {
      border-right: 1px solid var(--card-bg);
    }
    schema-stage-hruler,
    schema-stage-vruler {
      position: relative;
      overflow: hidden;
    }
    canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    schema-stage-surface {
      background-color: var(--input-inactive-bg);
      &:focus-visible {
        outline: 2px solid var(--foreground);
        outline-offset: -2px;
      }
    }

    schema-stage-frame {
      position: absolute;
      outline: 1px solid var(--card-bg);
      background: var(--background);
      &[data-resizing] iframe {
        pointer-events: none;
      }
    }
    iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .grid {
      position: absolute;
      inset: 0;
      display: none;
      pointer-events: none;
      background-image:
        linear-gradient(to right, oklch(1 0 0 / 0.06) 1px, transparent 1px),
        linear-gradient(to bottom, oklch(1 0 0 / 0.06) 1px, transparent 1px);
      background-size: 8px 8px;
    }
    schema-stage[data-grid] .grid {
      display: block;
    }

    [data-resize-handle] {
      --handle: calc(12px / var(--stage-zoom, 1));
      position: absolute;
      background: transparent;
      &:hover,
      &:focus-visible {
        background: oklch(from var(--green) l c h / 0.5);
        outline: none;
      }
    }
    [data-resize-handle="e"] {
      top: 0;
      bottom: var(--handle);
      left: 100%;
      width: var(--handle);
    }
    [data-resize-handle="s"] {
      top: 100%;
      left: 0;
      right: var(--handle);
      height: var(--handle);
    }
    [data-resize-handle="se"] {
      top: 100%;
      left: 100%;
      width: var(--handle);
      height: var(--handle);
    }
  }
</style>
